# This file should be safe to commit and can act as documentation for all the possible configurations of our server.
# Put local overrides in .env (git-ignored); environment variables take precedence over both files.

# HTTP server: /health/live, /metrics, /ping and the loopback content proxy.
# Not 8080: the godot asset server listens there inside the same container.
HTTP_SERVER_PORT=5000
HTTP_SERVER_HOST=0.0.0.0

# reset metrics at 00:00UTC
WKC_METRICS_RESET_AT_NIGHT=false
# Optional bearer token required by /metrics (empty => public)
WKC_METRICS_BEARER_TOKEN=

# AWS region for SQS and S3
AWS_REGION=us-east-1

# Job queues (SQS queue URLs). TASK_QUEUE is subscribed to the platform's deployment events;
# PRIORITY_TASK_QUEUE is optional, only fed by `yarn queue --priority`, and polled first.
# Neither set => in-memory queue (local one-offs with --entityId).
# e.g. https://sqs.us-east-1.amazonaws.com/000000000000/asset-optimizer-queue
TASK_QUEUE=
PRIORITY_TASK_QUEUE=
# Seconds a received job stays hidden from other workers. While the job runs the
# worker extends it every half-period (within SQS's 12 h limit); a transient or
# unclassified failure hands the job back with a backoff (5 min, 30 min, then 2 h)
# and the queue's redrive policy dead-letters it after maxReceiveCount receives.
# Every receive counts, including jobs handed back on shutdown or lost in a crash,
# so maxReceiveCount (set on the queue, not here) should leave room for those (6).
JOB_VISIBILITY_TIMEOUT_SECONDS=900
# ECS_AGENT_URI is injected by ECS (do not set it): when present, the worker holds
# task scale-in protection from its first claim until a poll finds every queue
# empty (renewed per job: bake budget + 30 min).

# Output bucket and version prefix (e.g. v6). Objects are written to <S3_PREFIX>/<file>.
# Both are required when TASK_QUEUE or PRIORITY_TASK_QUEUE is set (the worker refuses
# to start otherwise). Empty BUCKET without a queue => one-off output goes to ./storage
BUCKET=
S3_PREFIX=

# Local development only (LocalStack / MinIO). On AWS leave empty: the default
# credential chain (ECS task role) is used and S3 is addressed virtual-hosted-style.
SQS_ENDPOINT=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Catalyst used when a job carries no content server URL (content = <CATALYST_URL>/content)
CATALYST_URL=https://peer.decentraland.org
# Worlds content server, only used to resolve <name>.dcl.eth in --entityId one-offs
WORLDS_CONTENT_SERVER_URL=https://worlds-content-server.decentraland.org
# Optional comma-separated host allowlist for the content server URL a job carries
# (e.g. peer.decentraland.org,worlds-content-server.decentraland.org). Empty => allow all.
ALLOWED_CONTENT_SERVER_HOSTS=

# Fetch retry configuration
FETCH_MAX_RETRIES=3
FETCH_INITIAL_DELAY_MS=1000
FETCH_MAX_DELAY_MS=30000
FETCH_TIMEOUT_MS=60000
FETCH_BACKOFF_MULTIPLIER=2

# Asset server (godot-explorer --asset-server, started by this process)
ASSET_SERVER_URL=http://localhost:8080
# Port godot is started on (keep in sync with ASSET_SERVER_URL; empty => 8080)
ASSET_SERVER_PORT=
# Bake budget per entity, shared by every stall-retry pass (90 min)
ASSET_SERVER_TIMEOUT_MS=5400000
# Stalled-batch detection and retries (empty => built-in defaults)
ASSET_SERVER_MAX_STALL_RETRIES=
ASSET_SERVER_STALL_PANIC_MS=
ASSET_SERVER_STALL_DOWNLOAD_MS=
ASSET_SERVER_STALL_DOWNLOAD_JOB_MS=
ASSET_SERVER_MAX_STALLED_JOBS=
# Parallel bakes in the dev-only --profile <address> mode
ASSET_SERVER_CONCURRENT_BUNDLES=4

# Content pre-download into the godot cache (wearables/emotes; empty => built-in defaults)
GODOT_CONTENT_CACHE_PATH=
CONTENT_DOWNLOAD_CONCURRENCY=
CONTENT_DOWNLOAD_TIMEOUT_MS=
