# VCS / editor / CI
.git/
.github/
**/.DS_Store

# dependencies and build output (rebuilt inside the image)
node_modules/
dist/
dist-test/
coverage/
npm-debug.log
yarn-error.log

# local configuration: only the committed defaults go into the image
.env
.env.*
!.env.default

# local run output (local storage fallback, temp downloads, godot caches)
storage/
temp/
output/
original-content/
godot4_editor/

# local-only tooling
docker-compose.yml
scripts/local/
